<?xml version="1.0" encoding="utf-8"?>
<!-- Calificar lo que suena (lienzo movil, seccion 03): una linea con la
     cancion y las siete notas. Sin portada ni controles: eso ya lo trae
     Spotify. Es la misma contraida y expandida. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" android:singleLine="true" android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal">
        <TextView android:id="@+id/btn_ap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="A+" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/nota_texto_top" android:background="@drawable/nota_top" />
        <TextView android:id="@+id/btn_a" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="A" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/nota_texto_top" android:background="@drawable/nota_top" />
        <TextView android:id="@+id/btn_bp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="B+" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/nota_texto_top" android:background="@drawable/nota_top" />
        <TextView android:id="@+id/btn_b" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="B" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/nota_texto_mid" android:background="@drawable/nota_mid" />
        <TextView android:id="@+id/btn_cp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="C+" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/nota_texto_mid" android:background="@drawable/nota_mid" />
        <TextView android:id="@+id/btn_c" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="C" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/nota_texto_mid" android:background="@drawable/nota_mid" />
        <TextView android:id="@+id/btn_d" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="D" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/nota_texto_mid" android:background="@drawable/nota_d" />
    </LinearLayout>
</LinearLayout>
