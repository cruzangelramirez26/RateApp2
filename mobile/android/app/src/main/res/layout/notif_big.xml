<?xml version="1.0" encoding="utf-8"?>
<!-- Notificacion expandida: portada, cancion, estado y los 7 botones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
        <ImageView android:id="@+id/cover" android:layout_width="64dp" android:layout_height="64dp"
            android:layout_marginEnd="12dp" android:scaleType="centerCrop" android:contentDescription="Portada" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
            <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Line2" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal">
        <TextView android:id="@+id/btn_ap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="A+" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/rating_ap" android:background="@drawable/rate_out_ap" />
        <TextView android:id="@+id/btn_a" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="A" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/rating_a" android:background="@drawable/rate_out_a" />
        <TextView android:id="@+id/btn_bp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="B+" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/rating_bp" android:background="@drawable/rate_out_bp" />
        <TextView android:id="@+id/btn_b" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="B" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/rating_b" android:background="@drawable/rate_out_b" />
        <TextView android:id="@+id/btn_cp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="C+" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/rating_cp" android:background="@drawable/rate_out_cp" />
        <TextView android:id="@+id/btn_c" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="C" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/rating_c" android:background="@drawable/rate_out_c" />
        <TextView android:id="@+id/btn_d" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="D" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/rating_d" android:background="@drawable/rate_out_d" />
    </LinearLayout>
</LinearLayout>
