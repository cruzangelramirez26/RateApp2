<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4x1: la portada chica y las 7 notas (lienzo movil, seccion 04). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wg_fondo" android:clipToOutline="true">
    <ImageView android:id="@+id/wg_fondo_img" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/wg_borde" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="12dp">
        <ImageView android:id="@+id/wg_portada" android:layout_width="48dp" android:layout_height="48dp"
            android:scaleType="centerCrop" android:src="@drawable/wg_portada_vacia" android:contentDescription="Abrir RateApp" />
        <LinearLayout android:id="@+id/wg_notas" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="horizontal">
            <TextView android:id="@+id/wn_ap" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="A+" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/wg_t1" android:background="@drawable/wg_nota_top" />
            <TextView android:id="@+id/wn_a" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="A" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/wg_t1" android:background="@drawable/wg_nota_top" />
            <TextView android:id="@+id/wn_bp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="B+" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/wg_t1" android:background="@drawable/wg_nota_top" />
            <TextView android:id="@+id/wn_b" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="B" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/wg_t2" android:background="@drawable/wg_nota_mid" />
            <TextView android:id="@+id/wn_cp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="C+" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/wg_t2" android:background="@drawable/wg_nota_mid" />
            <TextView android:id="@+id/wn_c" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="C" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/wg_t2" android:background="@drawable/wg_nota_mid" />
            <TextView android:id="@+id/wn_d" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="D" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/wg_t3" android:background="@drawable/wg_nota_d" />
        </LinearLayout>
        <TextView android:id="@+id/wg_vacio" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp" android:visibility="gone"
            android:text="Pon algo en Spotify" android:textSize="14sp" android:textColor="@color/wg_t2" />
    </LinearLayout>
</FrameLayout>
