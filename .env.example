# Spotify API
SPOTIPY_CLIENT_ID=your_client_id
SPOTIPY_CLIENT_SECRET=your_client_secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8000/callback
# En produccion: https://rateapp-1043427819721.us-east4.run.app/callback
# Tiene que estar registrado tal cual en el Spotify Developer Dashboard.

# MySQL (TiDB Cloud Serverless — el host real vive en las env vars de Cloud Run)
MYSQL_HOST=your_host
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database
# OJO: no hay MYSQL_PORT. database.py nunca pasa el puerto, asi que el
# conector usa 3306. Funciona con TiDB porque escucha en 3306 y en 4000.

# App
SECRET_KEY=change_this_to_a_random_string
FRONTEND_URL=http://127.0.0.1:5173
PORT=8000
